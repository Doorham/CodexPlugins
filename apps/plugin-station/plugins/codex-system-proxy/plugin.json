{
  "id": "codex-system-proxy",
  "name": "Codex 对话 timeout 修复",
  "moduleVersion": "1.1.3",
  "developers": [
    "Althy",
    "DRHW"
  ],
  "description": "配置 Codex 系统代理开关，分别显示未检测、WebSocket 连通、连接失败与诊断不可用；不将所有 timeout 归因于代理。",
  "category": "系统",
  "icon": "↗",
  "accent": "#22c55e",
  "mode": "system",
  "handler": "codex_system_proxy",
  "recordFolder": "%CODEXTOOLS_USER_DATA_ROOT%\\CodexSystemProxy",
  "localDataPolicy": {
    "scope": "local-private",
    "paths": [
      "%USERPROFILE%\\.codex\\config.toml",
      "%CODEXTOOLS_USER_DATA_ROOT%\\CodexSystemProxy"
    ],
    "sync": false,
    "upload": false,
    "preserveOnUpdate": true,
    "containsCredentials": false
  },
  "actions": [
    "refresh",
    "repair"
  ],
  "uiActions": [
    {
      "id": "repair",
      "label": "配置系统代理",
      "kind": "primary"
    },
    {
      "id": "refresh",
      "label": "检测连接",
      "kind": "secondary"
    }
  ],
  "agentAccess": {
    "enabled": true,
    "actions": [
      "refresh"
    ]
  }
}
