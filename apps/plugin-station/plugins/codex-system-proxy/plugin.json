{
  "id": "codex-system-proxy",
  "name": "Codex 对话 timeout 修复",
  "moduleVersion": "1.1.0",
  "developers": ["Althy"],
  "description": "修复 Codex 未遵循 Windows 系统代理这一类 timeout，并独立检测 WebSocket。已配置时不再重复显示修复按钮；代理线路异常需要单独排查。",
  "category": "系统",
  "icon": "↗",
  "accent": "#22c55e",
  "mode": "system",
  "handler": "codex_system_proxy",
  "recordFolder": "%LOCALAPPDATA%\\CompanyAIHelpers\\CodexSystemProxy",
  "localDataPolicy": {
    "scope": "local-private",
    "paths": ["%USERPROFILE%\\.codex\\config.toml", "%LOCALAPPDATA%\\CompanyAIHelpers\\CodexSystemProxy"],
    "sync": false,
    "upload": false,
    "preserveOnUpdate": true,
    "containsCredentials": false
  },
  "actions": ["refresh", "repair"],
  "uiActions": [
    {"id": "repair", "label": "配置系统代理", "kind": "primary"},
    {"id": "refresh", "label": "检测连接", "kind": "secondary"}
  ],
  "agentAccess": {"enabled": true, "actions": ["refresh"]}
}
