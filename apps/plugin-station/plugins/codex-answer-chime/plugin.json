{
  "id": "codex-answer-chime",
  "name": "Codex 完成提示音",
  "moduleVersion": "1.0.2",
  "developers": ["Doorham", "Althy"],
  "description": "开启会立即运行并加入开机自启动；停用会停止程序并取消自启动。每次完成回答都会播放指定提示音。",
  "category": "Agent 联动",
  "icon": "♫",
  "accent": "#8b5cf6",
  "mode": "agent",
  "handler": "process_app",
  "executable": "%LOCALAPPDATA%\\CompanyAIHelpers\\CodexAnswerChime\\CodexAnswerChime.exe",
  "installSource": "artifacts/helpers/CodexAnswerChime.exe",
  "processName": "CodexAnswerChime.exe",
  "startup": {
    "type": "run",
    "name": "Codex Answer Chime",
    "legacyPaths": [
      "%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\Codex Answer Chime.lnk"
    ]
  },
  "actions": ["toggle_enabled", "test_sound", "set_sound"],
  "uiActions": [
    {"id": "toggle_enabled", "label": "切换状态", "kind": "toggle"},
    {"id": "test_sound", "label": "测试声音", "kind": "secondary"},
    {"id": "set_sound", "label": "选择声音", "kind": "secondary", "dialog": "sound"}
  ],
  "agentAccess": {"enabled": true, "actions": ["toggle_enabled", "test_sound"]}
}
